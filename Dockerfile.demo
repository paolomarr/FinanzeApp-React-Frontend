# Demo image: the built React app served by nginx, which also proxies the API.
#
# Built by the backend's docker-compose.demo.yml, either from this repo's
# GitHub URL or from a local checkout. It does not read .env (not in git):
# the API base is the relative "/api/", so the app talks to whatever host
# serves it, and nginx forwards /api/, /admin/ and /static/ to the `django` service.

FROM node:22-alpine AS build
ARG VERSION_INFO=demo
ENV VITE_BACKEND_API_BASE=/api/ \
    VITE_VERSION_INFO=${VERSION_INFO} \
    NODE_OPTIONS=--max_old_space_size=2048
WORKDIR /app
COPY package.json package-lock.json lingui.config.js ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY index.html vite.config.js ./
COPY public/ ./public
COPY src/ ./src
RUN npm run compile && npm run build

FROM nginx:1.27-alpine
COPY nginx.demo.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
